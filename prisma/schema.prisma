generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  sessions        Session[]
  accounts        Account[]
  person          Person?
  knownDevices    KnownDevice[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  PRO
}

enum ItemCategory {
  STARTER
  MAIN
  SIDE
  DRINK
  DESSERT
  GROCERY
  TRANSPORT
  HOUSEHOLD
  OTHER
}

enum ReceiptScanStatus {
  PENDING
  EXTRACTING
  SUCCEEDED
  FAILED
  CONSUMED
  DISCARDED
}

enum TellDraftStatus {
  DRAFTING
  SUCCEEDED
  FAILED
  CONSUMED
  DISCARDED
}

enum AskStatus {
  ASKING
  ANSWERED
  CLARIFY
  DECLINED
  FAILED
  CANCELLED
  PROPOSED
}

enum AskActionStatus {
  PROPOSED
  EXECUTING
  DONE
  CANCELLED
  FAILED
  UNDONE
}

enum BillStatus {
  DRAFT
  CLAIMING
  FINALIZED
}

enum SplitMethod {
  ITEMS
  EVEN
  SHARES
  PERCENT
  AMOUNT
}

enum TipKind {
  NONE
  PERCENT
  AMOUNT
}

enum PaymentMethod {
  VENMO
  CASH
  PAYPAL
  BANK
  OTHER
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ActivityType {
  BILL_CREATED
  BILL_UPDATED
  BILL_FINALIZED
  BILL_DELETED
  ITEM_CLAIMED
  ITEM_UNCLAIMED
  MEMBER_JOINED
  MEMBER_LEFT
  SETTLEMENT_RECORDED
  SETTLEMENT_CONFIRMED
  SETTLEMENT_CANCELLED
  BILL_CLAIMING_OPENED
  BILL_CLAIMED
  CLAIMS_REMINDED
}

model Person {
  id             String    @id @default(cuid())
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName    String
  tint           String
  buddy          String?
  email          String?
  onboardedAt    DateTime?
  activitySeenAt DateTime?
  plan           Plan      @default(FREE)
  timeZone       String?
  defaultCurrency String   @default("USD") @db.Char(3)
  deletedAt      DateTime?
  notifyBills    Boolean   @default(true)
  notifyClaims   Boolean   @default(true)
  notifyPayments Boolean   @default(true)
  notifyWeekly   Boolean   @default(true)
  notifyMonthly  Boolean   @default(true)
  mergedIntoId   String?
  mergedInto     Person?   @relation("PersonMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom     Person[]  @relation("PersonMerge")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  guestTokens        GuestToken[]
  groupsCreated      Group[]           @relation("GroupCreator")
  memberships        GroupMember[]
  membersAdded       GroupMember[]     @relation("MemberAddedBy")
  guestTokensIssued  GuestToken[]      @relation("GuestTokenCreator")
  billsPaid          Bill[]            @relation("BillPayer")
  billsCreated       Bill[]            @relation("BillCreator")
  billParticipations BillParticipant[]
  claims             Claim[]
  settlementsSent    Settlement[]      @relation("SettlementFrom")
  settlementsIn      Settlement[]      @relation("SettlementTo")
  settlementsLogged  Settlement[]      @relation("SettlementRecorder")
  activity           ActivityEvent[]
  receiptScans       ReceiptScan[]
  tellDrafts         TellDraft[]
  askQuestions       AskQuestion[]
  askActions         AskAction[]
  emailLogs          EmailLog[]

  @@index([mergedIntoId])
  @@map("person")
}

model GuestToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   Person    @relation("GuestTokenCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  @@index([personId, usedAt])
  @@index([groupId])
  @@map("guest_token")
}

model AppRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
  @@map("app_rate_limit")
}

model Group {
  id          String    @id @default(cuid())
  name        String
  tint        String
  art         String?
  currency    String    @db.Char(3)
  slug        String    @unique
  createdById String
  createdBy   Person    @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  members      GroupMember[]
  guestTokens  GuestToken[]
  bills        Bill[]
  settlements  Settlement[]
  activity     ActivityEvent[]
  receiptScans ReceiptScan[]
  tellDrafts   TellDraft[]
  askQuestions AskQuestion[]

  @@index([createdById])
  @@map("group")
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  addedById String?
  addedBy   Person?   @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([groupId, personId])
  @@index([personId])
  @@index([addedById])
  @@map("group_member")
}

model Bill {
  id            String       @id @default(cuid())
  groupId       String?
  group         Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  title         String
  occurredAt    DateTime
  currency      String       @db.Char(3)
  payerId       String
  payer         Person       @relation("BillPayer", fields: [payerId], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     Person       @relation("BillCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status        BillStatus   @default(DRAFT)
  splitMethod   SplitMethod  @default(ITEMS)
  taxCents      Int          @default(0)
  tipKind       TipKind      @default(NONE)
  tipValue      Int          @default(0)
  discountCents Int          @default(0)
  totalCents    Int          @default(0)
  slug          String       @unique
  claimCode     String?      @unique
  receiptScanId String?      @unique
  receiptScan   ReceiptScan? @relation(fields: [receiptScanId], references: [id], onDelete: SetNull)
  finalizedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  deletedAt     DateTime?

  participants BillParticipant[]
  items        LineItem[]
  activity     ActivityEvent[]

  @@index([groupId, occurredAt])
  @@index([payerId])
  @@index([createdById])
  @@map("bill")
}

model BillParticipant {
  id          String @id @default(cuid())
  billId      String
  bill        Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  personId    String
  person      Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  shares      Int    @default(1)
  percentBps  Int?
  amountCents Int?

  @@unique([billId, personId])
  @@index([personId])
  @@map("bill_participant")
}

model LineItem {
  id         String        @id @default(cuid())
  billId     String
  bill       Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int           @default(1)
  priceCents Int
  position   Int
  category   ItemCategory?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  claims Claim[]

  @@index([billId, position])
  @@map("line_item")
}

model Claim {
  id         String   @id @default(cuid())
  lineItemId String
  lineItem   LineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([lineItemId, personId])
  @@index([personId])
  @@map("claim")
}

model Settlement {
  id            String           @id @default(cuid())
  groupId       String?
  group         Group?           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  fromId        String
  from          Person           @relation("SettlementFrom", fields: [fromId], references: [id], onDelete: Restrict)
  toId          String
  to            Person           @relation("SettlementTo", fields: [toId], references: [id], onDelete: Restrict)
  currency      String           @db.Char(3)
  amountCents   Int
  method        PaymentMethod
  note          String?
  recordedById  String
  recordedBy    Person           @relation("SettlementRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  status        SettlementStatus
  autoConfirmAt DateTime?
  confirmedAt   DateTime?
  undoUntil     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  @@index([groupId])
  @@index([fromId])
  @@index([toId])
  @@index([recordedById])
  @@map("settlement")
}

model ActivityEvent {
  id        String       @id @default(cuid())
  groupId   String?
  group     Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  billId    String?
  bill      Bill?        @relation(fields: [billId], references: [id], onDelete: Restrict)
  actorId   String?
  actor     Person?      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  @@index([groupId, createdAt])
  @@index([billId, createdAt])
  @@index([actorId])
  @@map("activity_event")
}

model ReceiptScan {
  id           String            @id @default(cuid())
  personId     String
  person       Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  objectKey    String            @unique
  contentType  String
  byteSize     Int
  timeZone     String
  status       ReceiptScanStatus @default(PENDING)
  failure      String?
  result       Json?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime          @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  purgedAt     DateTime?
  bill         Bill?

  @@index([personId, status, startedAt])
  @@index([groupId, createdAt])
  @@index([status, createdAt])
  @@map("receipt_scan")
}

model TellDraft {
  id           String          @id @default(cuid())
  personId     String
  person       Person          @relation(fields: [personId], references: [id], onDelete: Restrict)
  groupId      String
  group        Group           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  text         String?
  timeZone     String
  status       TellDraftStatus @default(DRAFTING)
  failure      String?
  result       Json?
  answers      Json?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime        @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([personId, status, startedAt])
  @@index([status, createdAt])
  @@map("tell_draft")
}

model AskQuestion {
  id           String    @id @default(cuid())
  personId     String
  person       Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  threadId     String
  groupId      String?
  group        Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  text         String?
  timeZone     String
  status       AskStatus @default(ASKING)
  failure      String?
  outcome      String?
  trace        Json?
  steps        Int?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([personId, status, startedAt])
  @@index([personId, threadId, createdAt])
  @@index([status, createdAt])
  @@map("ask_question")
}

model AskAction {
  id          String          @id @default(cuid())
  personId    String
  person      Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  questionId  String?         @unique
  threadId    String?
  kind        String
  intent      Json
  fingerprint String
  status      AskActionStatus @default(PROPOSED)
  result      Json?
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  claimedAt   DateTime?
  executedAt  DateTime?

  @@index([personId, status, executedAt])
  @@index([createdAt])
  @@map("ask_action")
}

model EmailLog {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind      String
  dedupeKey String   @unique
  createdAt DateTime @default(now())

  @@index([personId, createdAt])
  @@map("email_log")
}

model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, fingerprint])
  @@map("known_device")
}
