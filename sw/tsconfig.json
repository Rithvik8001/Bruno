{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["webworker", "es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@/*": ["../*"],
    },
  },
  "include": ["./**/*.ts", "../lib/push/payload.ts"],
}
